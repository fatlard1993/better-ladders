{
  "schemaVersion": 1,
  "id": "better-ladders-justfatlard",
  "version": "${version}",
  "name": "Better Ladders",
  "description": "Ladders with rails and rungs, standing wherever you put them, and a rope ladder that unrolls itself",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/better-ladders"
  },
  "license": "MIT",
  "icon": "assets/better-ladders-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.better_ladders.Main"
    ]
  },
  "mixins": [
    "better-ladders-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": "*"
  }
}
